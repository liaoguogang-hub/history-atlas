# 统一换行符，避免跨平台差异与 CRLF 警告
* text=auto

# 源码与文档统一 LF
*.kt   text eol=lf
*.kts  text eol=lf
*.py   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.xml  text eol=lf

# Windows 批处理与 PowerShell 保持 CRLF
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Git 钩子必须 LF：Git Bash 执行 CRLF 脚本时会把 \r 带进参数，
# 曾导致 pre-commit 里 $PROJECT_DIR 变成 history-atlas\r，
# sed 读不到 build.gradle.kts，版本检查整体失效。
.githooks/* text eol=lf
*.cmd text eol=crlf

# Gradle wrapper 的 shell 脚本必须是 LF，否则在 Linux/macOS 上无法执行
gradlew        text eol=lf
*.jar          binary
*.jpg          binary
*.png          binary
*.apk          binary
