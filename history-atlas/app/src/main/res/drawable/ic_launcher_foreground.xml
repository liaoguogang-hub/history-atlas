        android:pathData="M54,60 L59,60 L56,66 L46,73 L43,69 L50,64 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,64 L58,68 L66,73 L63,76 L54,70 Z" />

