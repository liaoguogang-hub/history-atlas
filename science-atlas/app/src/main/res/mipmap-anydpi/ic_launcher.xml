<?xml version="1.0" encoding="utf-8"?>
<!--
    API 24–25 的启动图标回退版本（自适应图标 mipmap-anydpi-v26 从 API 26 起才生效）。
    同样是靛蓝底 + 白色原子轨道，但铺满整个图标，不做圆形遮罩。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 背景 -->
    <path
        android:fillColor="#33518C"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />

    <!-- 水平轨道 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,52 m-26,0 a26,8 0 1,0 52,0 a26,8 0 1,0 -52,0 Z
                          M54,52 m-22,0 a22,8 0 1,0 44,0 a22,8 0 1,0 -44,0 Z"
        android:fillType="evenOdd" />

    <!-- 轨道旋转 60° -->
    <group
        android:pivotX="54"
        android:pivotY="52"
        android:rotation="60">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M54,52 m-26,0 a26,8 0 1,0 52,0 a26,8 0 1,0 -52,0 Z
                              M54,52 m-22,0 a22,8 0 1,0 44,0 a22,8 0 1,0 -44,0 Z"
            android:fillType="evenOdd" />
    </group>

    <!-- 轨道旋转 -60° -->
    <group
        android:pivotX="54"
        android:pivotY="52"
        android:rotation="-60">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M54,52 m-26,0 a26,8 0 1,0 52,0 a26,8 0 1,0 -52,0 Z
                              M54,52 m-22,0 a22,8 0 1,0 44,0 a22,8 0 1,0 -44,0 Z"
            android:fillType="evenOdd" />
    </group>

    <!-- 原子核 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,42 a10,10 0 1,0 0.1,0 Z" />
</vector>
