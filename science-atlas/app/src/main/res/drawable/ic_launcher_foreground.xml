<?xml version="1.0" encoding="utf-8"?>
<!--
    自适应图标前景：白色原子轨道造型（一个核 + 三条倾斜椭圆轨道）。
    前景内容被限制在中间 66dp 的安全区内（108dp 画布的中心 72dp 区域）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 水平轨道 -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.95"
        android:pathData="M54,52 m-26,0 a26,8 0 1,0 52,0 a26,8 0 1,0 -52,0 Z
                          M54,52 m-22,0 a22,8 0 1,0 44,0 a22,8 0 1,0 -44,0 Z"
        android:fillType="evenOdd" />

    <!-- 轨道旋转 60° -->
    <group
        android:pivotX="54"
        android:pivotY="52"
        android:rotation="60">
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.95"
            android:pathData="M54,52 m-26,0 a26,8 0 1,0 52,0 a26,8 0 1,0 -52,0 Z
                              M54,52 m-22,0 a22,8 0 1,0 44,0 a22,8 0 1,0 -44,0 Z"
            android:fillType="evenOdd" />
    </group>

    <!-- 轨道旋转 -60° -->
    <group
        android:pivotX="54"
        android:pivotY="52"
        android:rotation="-60">
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.95"
            android:pathData="M54,52 m-26,0 a26,8 0 1,0 52,0 a26,8 0 1,0 -52,0 Z
                              M54,52 m-22,0 a22,8 0 1,0 44,0 a22,8 0 1,0 -44,0 Z"
            android:fillType="evenOdd" />
    </group>

    <!-- 原子核 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,44 a8,8 0 1,0 0.1,0 Z" />
</vector>
